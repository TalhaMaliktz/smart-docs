// backend/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // NEW: Required for pgvector
}

datasource db {
  provider   = "postgresql"
  // Intentionally leaving URL out based on your custom NestJS implementation
  extensions = [vector] // NEW: Enables pgvector in Postgres
}

enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  documents Document[]
}

model Document {
  id           String          @id @default(uuid())
  title        String
  content      String?         @db.Text
  status       IngestionStatus @default(PENDING)
  fileSize     Int?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])
  
  // NEW: A document has many chunks
  chunks       DocumentChunk[]
}

// NEW: The Vector Memory Layer
model DocumentChunk {
  id         String   @id @default(uuid())
  text       String   @db.Text
  
  // CHANGED: Gemini outputs 768 dimensions, not 1536
  embedding  Unsupported("vector(3072)")
  
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(uuid())
  action    String   
  cost      Float    
  timestamp DateTime @default(now())
}